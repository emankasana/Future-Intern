const CartContext = createContext(null);

const cartReducer = (state, action) => {
  switch (action.type) {
    case "INIT": {
      return action.payload || [];
    }
    case "ADD": {
      const { id } = action;
      const existing = state.find((i) => i.id === id);
      if (existing) {
        return state.map((i) => (i.id === id ? { ...i, qty: Math.min(i.qty + 1, 99) } : i));
      }
      return [...state, { id, qty: 1 }];
    }
    case "INC": {
      return state.map((i) => (i.id === action.id ? { ...i, qty: Math.min(i.qty + 1, 99) } : i));
    }
    case "DEC": {
      return state
        .map((i) => (i.id === action.id ? { ...i, qty: Math.max(i.qty - 1, 1) } : i))
        .filter((i) => i.qty > 0);
    }
    case "REMOVE": {
      return state.filter((i) => i.id !== action.id);
    }
    case "CLEAR": {
      return [];
    }
    default:
      return state;
  }
};

const CartProvider = ({ children }) => {
  const [state, dispatch] = useReducer(cartReducer, []);

  // hydrate from localStorage
  useEffect(() => {
    try {
      const raw = localStorage.getItem("mini-cart");
      if (raw) dispatch({ type: "INIT", payload: JSON.parse(raw) });
    } catch {}
  }, []);

  // persist to localStorage
  useEffect(() => {
    try {
      localStorage.setItem("mini-cart", JSON.stringify(state));
    } catch {}
  }, [state]);

  const add = (id) => dispatch({ type: "ADD", id });
  const inc = (id) => dispatch({ type: "INC", id });
  const dec = (id) => dispatch({ type: "DEC", id });
  const remove = (id) => dispatch({ type: "REMOVE", id });
  const clear = () => dispatch({ type: "CLEAR" });

  const value = useMemo(() => ({ items: state, add, inc, dec, remove, clear }), [state]);
  return <CartContext.Provider value={value}>{children}</CartContext.Provider>;
};

const useCart = () => useContext(CartContext);



